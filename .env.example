# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio & Cloud Run inject this at runtime from Secret Manager.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The URL where this application is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="YOUR_APP_URL"

# GOOGLE_MAPS_API_KEY: Required for backend configuration endpoint & server-side geocoding.
GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"

# VITE_GOOGLE_MAPS_API_KEY: Required for client-side Vite Google Maps JS API loader.
VITE_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"
