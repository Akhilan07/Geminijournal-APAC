rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny all unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }

    // User-isolated journals: Users can only read and write their own journal documents
    match /users/{userId}/journals/{journalId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // User-isolated interactions: Users can only read and write their own documents
    match /users/{userId}/interactions/{interactionId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
